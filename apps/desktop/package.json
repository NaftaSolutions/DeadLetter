{
  "name": "@deadletter/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/renderer/src/*.test.mts",
    "test:e2e": "electron-vite build && node --test --test-concurrency=1 --test-timeout=60000 --test-reporter=spec e2e/*.test.mts"
  },
  "dependencies": {
    "@deadletter/engine": "workspace:*",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.70.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
